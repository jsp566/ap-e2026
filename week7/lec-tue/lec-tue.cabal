cabal-version:      3.0
name:               lec-tue
version:            1.0.0.0
build-type:         Simple

common common
    default-language: Haskell2010
    ghc-options: -Wall -O2

library
    import: common
    hs-source-dirs: src
    build-depends:
        base
      , array
    exposed-modules:
        Order
        Equiv
        Disc
        CDisc
        MDisc
        QDisc
        SDisc
        SDiscComb
        NatDisc
        NatDiscFA
        NatDiscFake
        NatDiscST
        MSet
        SQL4
        FSet

executable NatDiscBench
    import: common
    hs-source-dirs: src
    main-is: NatDiscBench.hs
    build-depends:
        base
      , array
      , random
      , criterion
      , lec-tue

executable SQL4Bench
    import: common
    hs-source-dirs: src
    main-is: SQL4Bench.hs
    build-depends:
        base
      , array
      , lec-tue
